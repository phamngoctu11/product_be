  <bpmn:process id="ApproveCartProcess" name="ApproveCartProcess" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="StartEvent_1" name="Nhan_don_hang">
      <bpmn:outgoing>Flow_1c54bu8</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_0rfojij" name="Kiem-tra_va_tru_ton_kho" camunda:delegateExpression="${deductInventoryDelegate}">
      <bpmn:extensionElements />
      <bpmn:incoming>Flow_07a1swb</bpmn:incoming>
      <bpmn:incoming>Flow_0ksbeoc</bpmn:incoming>
      <bpmn:outgoing>Flow_1hqdvv9</bpmn:outgoing>
    </bpmn:serviceTask>
