    <bpmn:sequenceFlow id="Flow_1s2qz4d" name="có" sourceRef="Gateway_1f2yxdo" targetRef="admin_xac_nhan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isStockSufficient == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="Activity_12tazkn" name="khach_nhan_hang">
      <bpmn:incoming>Flow_036rleh</bpmn:incoming>
      <bpmn:outgoing>Flow_0utc91c</bpmn:outgoing>
