    <bpmn:sequenceFlow id="Flow_1b2e9ma" name="không" sourceRef="Gateway_1f2yxdo" targetRef="Activity_19exb78">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isStockSufficient == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="admin_xac_nhan" name="admin_xac_nhan">
      <bpmn:incoming>Flow_1s2qz4d</bpmn:incoming>
