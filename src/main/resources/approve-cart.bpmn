    <bpmn:sequenceFlow id="Flow_036rleh" name="duyệt" sourceRef="admin_xac_nhan" targetRef="Activity_12tazkn">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isApproved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_1s3q4kl" name="hoan_thanh_don_hang">
