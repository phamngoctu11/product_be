            <column name="assigned_at" type="datetime"><constraints nullable="false"/></column>
            <column name="status" type="varchar(24)"><constraints nullable="false"/></column>
            <column name="released_at" type="datetime"><constraints nullable="true"/></column>
            <column name="release_reason" type="varchar(32)"><constraints nullable="true"/></column>
            <column name="active_order_id" type="bigint"><constraints nullable="true"/></column>
            <column name="active_staff_id" type="varchar(36)"><constraints nullable="true"/></column>
        </createTable>
        <addUniqueConstraint tableName="order_assignments" columnNames="active_order_id" constraintName="uk_order_assignments_1"/>
        <addUniqueConstraint tableName="order_assignments" columnNames="active_staff_id" constraintName="uk_order_assignments_2"/>
        <addForeignKeyConstraint baseTableName="order_assignments" baseColumnNames="order_id" referencedTableName="orders" referencedColumnNames="id" constraintName="fk_order_assignments_order_id"/>
        <addForeignKeyConstraint baseTableName="order_assignments" baseColumnNames="staff_id" referencedTableName="users" referencedColumnNames="id" constraintName="fk_order_assignments_staff_id"/>
        <addForeignKeyConstraint baseTableName="order_assignments" baseColumnNames="assigned_by" referencedTableName="users" referencedColumnNames="id" constraintName="fk_order_assignments_assigned_by"/>
        <addForeignKeyConstraint baseTableName="order_assignments" baseColumnNames="active_order_id" referencedTableName="orders" referencedColumnNames="id" constraintName="fk_order_assignments_active_order_id"/>
        <addForeignKeyConstraint baseTableName="order_assignments" baseColumnNames="active_staff_id" referencedTableName="users" referencedColumnNames="id" constraintName="fk_order_assignments_active_staff_id"/>
    </changeSet>
    <changeSet id="02-assignment-invariant" author="workflow">
        <sql>ALTER TABLE order_assignments ADD CONSTRAINT ck_order_assignment_active CHECK (
            (status = 'ACTIVE' AND active_order_id IS NOT NULL AND active_staff_id IS NOT NULL
                AND active_order_id = order_id AND active_staff_id = staff_id AND released_at IS NULL AND release_reason IS NULL)
            OR (status = 'RELEASED' AND active_order_id IS NULL AND active_staff_id IS NULL
                AND released_at IS NOT NULL AND release_reason IS NOT NULL AND release_reason IN ('FINAL_KCS_PASSED', 'ORDER_CANCELLED')))
        </sql>
    </changeSet>
    <changeSet id="02-backfill-safe-data" author="workflow">
        <!-- Preserve lifecycle states and unknown payment outcomes; neither is inferred from shipping. -->
        <sql>UPDATE orders SET order_type = 'CATALOG' WHERE order_type IS NULL</sql>
        <sql>UPDATE orders SET payment_method_v2 = UPPER(TRIM(payment_method)) WHERE UPPER(TRIM(payment_method)) IN ('COD', 'ONLINE') AND payment_method_v2 IS NULL</sql>
        <sql>UPDATE orders SET payment_status = 'PENDING' WHERE status = 'PENDING_PAYMENT' AND payment_method_v2 = 'ONLINE' AND payment_status IS NULL</sql>
        <sql>UPDATE orders SET payment_status = 'NOT_DUE' WHERE payment_method_v2 = 'COD' AND payment_status IS NULL</sql>
        <sql>UPDATE order_item SET source_type = 'CATALOG' WHERE product_variant_id IS NOT NULL AND source_type IS NULL</sql>
    </changeSet>
    <changeSet id="02-order-staff-reference" author="workflow">
        <addForeignKeyConstraint baseTableName="orders" baseColumnNames="assigned_staff_id" referencedTableName="users" referencedColumnNames="id" constraintName="fk_orders_assigned_staff"/>
        <createIndex tableName="orders" indexName="idx_orders_assigned_staff"><column name="assigned_staff_id"/></createIndex>
    </changeSet>
    <changeSet id="02-order-status-varchar" author="workflow">
        <!-- MySQL Hibernate ENUM columns otherwise reject newly introduced lifecycle values. -->
        <modifyDataType tableName="orders" columnName="status" newDataType="varchar(50)"/>
        <modifyDataType tableName="orderhistory" columnName="oldstatus" newDataType="varchar(50)"/>
        <modifyDataType tableName="orderhistory" columnName="newstatus" newDataType="varchar(50)"/>
    </changeSet>
    <changeSet id="02-catalog-duration-constraint" author="workflow">
        <sql>ALTER TABLE products ADD CONSTRAINT ck_products_made_day CHECK (made_day IS NULL OR made_day &gt;= 2)</sql>
    </changeSet>
</databaseChangeLog>
