<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <changeSet id="06-custom-request-content-longtext" author="workflow">
        <modifyDataType tableName="custom_requests" columnName="spec" newDataType="longtext"/>
        <modifyDataType tableName="custom_requests" columnName="attachments" newDataType="longtext"/>
        <update tableName="custom_requests">
            <column name="attachments" value="[]"/>
            <where>attachments IS NULL OR TRIM(attachments) = ''</where>
        </update>
        <addNotNullConstraint tableName="custom_requests" columnName="attachments" columnDataType="longtext"/>
        <modifyDataType tableName="order_item" columnName="spec_snapshot" newDataType="longtext"/>
    </changeSet>
</databaseChangeLog>
