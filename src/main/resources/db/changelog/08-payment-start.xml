<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <changeSet id="08-payment-attempt-lookup-indexes" author="workflow">
        <createIndex tableName="payment_attempts" indexName="idx_payment_attempt_order_status">
            <column name="order_id"/>
            <column name="status"/>
            <column name="opened_at"/>
        </createIndex>
        <createIndex tableName="payment_attempts" indexName="idx_payment_attempt_due">
            <column name="status"/>
            <column name="due_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
