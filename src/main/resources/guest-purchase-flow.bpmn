<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_GuestPurchaseFlow" targetNamespace="http://handmade-shop/process/guest-purchase" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:message id="Message_GuestPaymentSuccess" name="Msg_GuestPaymentSuccess" />
  <bpmn:process id="GuestPurchaseFlow" name="Guest Purchase Flow" isExecutable="false" camunda:historyTimeToLive="180">
    <bpmn:documentation>
      Guest purchase flow for non-user checkout. Guest cart is identified by guestSessionId.
      Guest order stores contact snapshot and orderLookupToken. Handmade items continue through
      staff assignment and two checkpoint stages, with manager review depending on policy.
    </bpmn:documentation>
    <bpmn:startEvent id="Start_GuestCheckoutSubmitted" name="Guest checkout submitted">
      <bpmn:outgoing>Flow_Start_To_ResolveSession</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ResolveGuestSession" name="Resolve guest session" camunda:delegateExpression="${workflowTaskDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="taskType">RESOLVE_GUEST_SESSION</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_To_ResolveSession</bpmn:incoming>
      <bpmn:outgoing>Flow_ResolveSession_To_ValidateCheckout</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ValidateGuestCheckout" name="Validate cart, contact, voucher" camunda:delegateExpression="${workflowTaskDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="taskType">VALIDATE_GUEST_CHECKOUT</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ResolveSession_To_ValidateCheckout</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidateCheckout_To_GatewayValid</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_GuestCheckoutValid" name="Checkout valid?">
      <bpmn:incoming>Flow_ValidateCheckout_To_GatewayValid</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckoutInvalid_To_Reject</bpmn:outgoing>
      <bpmn:outgoing>Flow_CheckoutValid_To_Reserve</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RejectGuestCheckout" name="Reject checkout" camunda:delegateExpression="${workflowTaskDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="taskType">REJECT_GUEST_CHECKOUT</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CheckoutInvalid_To_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_Reject_To_EndRejected</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_GuestCheckoutRejected" name="Checkout rejected">
      <bpmn:incoming>Flow_Reject_To_EndRejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_ReserveInventoryAndVoucher" name="Reserve stock and voucher" camunda:delegateExpression="${workflowTaskDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="taskType">RESERVE_STOCK_AND_VOUCHER</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CheckoutValid_To_Reserve</bpmn:incoming>
      <bpmn:outgoing>Flow_Reserve_To_PaymentGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_GuestPaymentMethod" name="Payment method">
      <bpmn:incoming>Flow_Reserve_To_PaymentGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_COD_To_CreateOrder</bpmn:outgoing>
      <bpmn:outgoing>Flow_Online_To_CreatePayment</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CreateGuestPayment" name="Create online payment" camunda:delegateExpression="${workflowTaskDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="taskType">CREATE_GUEST_PAYMENT</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Online_To_CreatePayment</bpmn:incoming>
      <bpmn:outgoing>Flow_CreatePayment_To_WaitPayment</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:eventBasedGateway id="Gateway_WaitGuestPayment" name="Wait payment result">
      <bpmn:incoming>Flow_CreatePayment_To_WaitPayment</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitPayment_To_PaymentSuccess</bpmn:outgoing>
      <bpmn:outgoing>Flow_WaitPayment_To_PaymentTimeout</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Event_GuestPaymentSuccess" name="Payment success">
      <bpmn:incoming>Flow_WaitPayment_To_PaymentSuccess</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentSuccess_To_CreateOrder</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_GuestPaymentSuccess" messageRef="Message_GuestPaymentSuccess" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateCatchEvent id="Event_GuestPaymentTimeout" name="Payment timeout 15m">
      <bpmn:incoming>Flow_WaitPayment_To_PaymentTimeout</bpmn:incoming>
      <bpmn:outgoing>Flow_PaymentTimeout_To_CancelReservation</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_GuestPaymentTimeout">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_CancelGuestReservation" name="Cancel reservation" camunda:delegateExpression="${workflowTaskDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="taskType">CANCEL_GUEST_RESERVATION</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PaymentTimeout_To_CancelReservation</bpmn:incoming>
      <bpmn:outgoing>Flow_CancelReservation_To_EndExpired</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_GuestPaymentExpired" name="Payment expired">
      <bpmn:incoming>Flow_CancelReservation_To_EndExpired</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_CreateGuestOrder" name="Create guest order" camunda:delegateExpression="${workflowTaskDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="taskType">CREATE_GUEST_ORDER</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_COD_To_CreateOrder</bpmn:incoming>
      <bpmn:incoming>Flow_PaymentSuccess_To_CreateOrder</bpmn:incoming>
      <bpmn:outgoing>Flow_CreateOrder_To_SaveSnapshot</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SaveGuestSnapshotLookupToken" name="Save contact snapshot and lookup token" camunda:delegateExpression="${workflowTaskDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="taskType">SAVE_GUEST_CONTACT_SNAPSHOT</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CreateOrder_To_SaveSnapshot</bpmn:incoming>
      <bpmn:outgoing>Flow_SaveSnapshot_To_PublishOrderCreated</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PublishGuestOrderCreated" name="Publish GUEST_ORDER_CREATED event" camunda:delegateExpression="${workflowTaskDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="taskType">PUBLISH_WORKFLOW_EVENT</camunda:inputParameter>
          <camunda:inputParameter name="eventType">GUEST_ORDER_CREATED</camunda:inputParameter>
          <camunda:inputParameter name="streamName">order-events</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SaveSnapshot_To_PublishOrderCreated</bpmn:incoming>
      <bpmn:outgoing>Flow_PublishOrderCreated_To_HandmadeGateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ContainsHandmadeItems" name="Contains handmade items?">
      <bpmn:incoming>Flow_PublishOrderCreated_To_HandmadeGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_NoHandmade_To_PackReadyMade</bpmn:outgoing>
      <bpmn:outgoing>Flow_HasHandmade_To_AssignStaff</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_StaffPackReadyMadeItems" name="Staff packs ready-made items" camunda:candidateGroups="STAFF">
      <bpmn:incoming>Flow_NoHandmade_To_PackReadyMade</bpmn:incoming>
      <bpmn:outgoing>Flow_PackReadyMade_To_SendReadyEmail</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_SendGuestReadyToShipEmail" name="Send ready-to-ship email" camunda:delegateExpression="${workflowTaskDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="taskType">SEND_EMAIL</camunda:inputParameter>
          <camunda:inputParameter name="emailType">GUEST_READY_TO_SHIP</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PackReadyMade_To_SendReadyEmail</bpmn:incoming>
      <bpmn:outgoing>Flow_SendReadyEmail_To_EndReadyMade</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_GuestOrderReadyMadeReady" name="Ready-made order ready to ship">
      <bpmn:incoming>Flow_SendReadyEmail_To_EndReadyMade</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Task_ManagerAssignStaffByItem" name="Manager assigns staff by item" camunda:candidateGroups="MANAGER">
      <bpmn:incoming>Flow_HasHandmade_To_AssignStaff</bpmn:incoming>
      <bpmn:outgoing>Flow_AssignStaff_To_SubmitInitial</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_StaffSubmitInitialCheckpoint" name="Staff submits INITIAL_SHAPE checkpoint" camunda:candidateGroups="STAFF">
      <bpmn:incoming>Flow_AssignStaff_To_SubmitInitial</bpmn:incoming>
      <bpmn:incoming>Flow_ReworkInitial_To_SubmitInitial</bpmn:incoming>
      <bpmn:outgoing>Flow_SubmitInitial_To_InitialReviewPolicy</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_InitialCheckpointReviewPolicy" name="Need manager review?">
      <bpmn:incoming>Flow_SubmitInitial_To_InitialReviewPolicy</bpmn:incoming>
      <bpmn:outgoing>Flow_InitialReviewNotRequired_To_SendInitialEmail</bpmn:outgoing>
      <bpmn:outgoing>Flow_InitialReviewRequired_To_ManagerReviewInitial</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ManagerReviewInitialCheckpoint" name="Manager reviews INITIAL_SHAPE" camunda:candidateGroups="MANAGER">
      <bpmn:incoming>Flow_InitialReviewRequired_To_ManagerReviewInitial</bpmn:incoming>
      <bpmn:outgoing>Flow_ManagerReviewInitial_To_InitialApprovedGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_InitialCheckpointApproved" name="Initial approved?">
      <bpmn:incoming>Flow_ManagerReviewInitial_To_InitialApprovedGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_InitialRejected_To_ReworkInitial</bpmn:outgoing>
      <bpmn:outgoing>Flow_InitialApproved_To_SendInitialEmail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_StaffReworkInitialCheckpoint" name="Staff reworks initial shape" camunda:candidateGroups="STAFF">
      <bpmn:incoming>Flow_InitialRejected_To_ReworkInitial</bpmn:incoming>
      <bpmn:outgoing>Flow_ReworkInitial_To_SubmitInitial</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_SendGuestInitialCheckpointEmail" name="Send checkpoint 1 email to guest" camunda:delegateExpression="${workflowTaskDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="taskType">SEND_EMAIL</camunda:inputParameter>
          <camunda:inputParameter name="emailType">GUEST_CHECKPOINT_INITIAL_SHAPE</camunda:inputParameter>
          <camunda:inputParameter name="checkpointStage">INITIAL_SHAPE</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_InitialReviewNotRequired_To_SendInitialEmail</bpmn:incoming>
      <bpmn:incoming>Flow_InitialApproved_To_SendInitialEmail</bpmn:incoming>
      <bpmn:outgoing>Flow_SendInitialEmail_To_SubmitFinal</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_StaffSubmitFinalCheckpoint" name="Staff submits FINAL_PRODUCT checkpoint" camunda:candidateGroups="STAFF">
      <bpmn:incoming>Flow_SendInitialEmail_To_SubmitFinal</bpmn:incoming>
      <bpmn:incoming>Flow_ReworkFinal_To_SubmitFinal</bpmn:incoming>
      <bpmn:outgoing>Flow_SubmitFinal_To_ManagerFinalQC</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ManagerFinalQC" name="Manager final QC" camunda:candidateGroups="MANAGER">
      <bpmn:incoming>Flow_SubmitFinal_To_ManagerFinalQC</bpmn:incoming>
      <bpmn:outgoing>Flow_ManagerFinalQC_To_FinalApprovedGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_FinalCheckpointApproved" name="Final approved?">
      <bpmn:incoming>Flow_ManagerFinalQC_To_FinalApprovedGateway</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalRejected_To_ReworkFinal</bpmn:outgoing>
      <bpmn:outgoing>Flow_FinalApproved_To_SendFinalEmail</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_StaffReworkFinalCheckpoint" name="Staff reworks final product" camunda:candidateGroups="STAFF">
      <bpmn:incoming>Flow_FinalRejected_To_ReworkFinal</bpmn:incoming>
      <bpmn:outgoing>Flow_ReworkFinal_To_SubmitFinal</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_SendGuestFinalCheckpointEmail" name="Send final checkpoint email to guest" camunda:delegateExpression="${workflowTaskDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="taskType">SEND_EMAIL</camunda:inputParameter>
          <camunda:inputParameter name="emailType">GUEST_CHECKPOINT_FINAL_PRODUCT</camunda:inputParameter>
          <camunda:inputParameter name="checkpointStage">FINAL_PRODUCT</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FinalApproved_To_SendFinalEmail</bpmn:incoming>
      <bpmn:outgoing>Flow_SendFinalEmail_To_MarkReady</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_MarkGuestOrderItemReady" name="Mark item ready to ship" camunda:delegateExpression="${workflowTaskDelegate}">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="taskType">MARK_ORDER_ITEM_READY_TO_SHIP</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SendFinalEmail_To_MarkReady</bpmn:incoming>
      <bpmn:outgoing>Flow_MarkReady_To_EndHandmadeReady</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_GuestHandmadeOrderReady" name="Handmade item ready to ship">
      <bpmn:incoming>Flow_MarkReady_To_EndHandmadeReady</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_To_ResolveSession" sourceRef="Start_GuestCheckoutSubmitted" targetRef="Task_ResolveGuestSession" />
    <bpmn:sequenceFlow id="Flow_ResolveSession_To_ValidateCheckout" sourceRef="Task_ResolveGuestSession" targetRef="Task_ValidateGuestCheckout" />
    <bpmn:sequenceFlow id="Flow_ValidateCheckout_To_GatewayValid" sourceRef="Task_ValidateGuestCheckout" targetRef="Gateway_GuestCheckoutValid" />
    <bpmn:sequenceFlow id="Flow_CheckoutInvalid_To_Reject" name="Invalid" sourceRef="Gateway_GuestCheckoutValid" targetRef="Task_RejectGuestCheckout">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${guestCheckoutValid == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CheckoutValid_To_Reserve" name="Valid" sourceRef="Gateway_GuestCheckoutValid" targetRef="Task_ReserveInventoryAndVoucher">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${guestCheckoutValid == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Reject_To_EndRejected" sourceRef="Task_RejectGuestCheckout" targetRef="End_GuestCheckoutRejected" />
    <bpmn:sequenceFlow id="Flow_Reserve_To_PaymentGateway" sourceRef="Task_ReserveInventoryAndVoucher" targetRef="Gateway_GuestPaymentMethod" />
    <bpmn:sequenceFlow id="Flow_COD_To_CreateOrder" name="COD" sourceRef="Gateway_GuestPaymentMethod" targetRef="Task_CreateGuestOrder">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentMethod == 'COD'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Online_To_CreatePayment" name="ONLINE" sourceRef="Gateway_GuestPaymentMethod" targetRef="Task_CreateGuestPayment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentMethod == 'ONLINE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CreatePayment_To_WaitPayment" sourceRef="Task_CreateGuestPayment" targetRef="Gateway_WaitGuestPayment" />
    <bpmn:sequenceFlow id="Flow_WaitPayment_To_PaymentSuccess" sourceRef="Gateway_WaitGuestPayment" targetRef="Event_GuestPaymentSuccess" />
    <bpmn:sequenceFlow id="Flow_WaitPayment_To_PaymentTimeout" sourceRef="Gateway_WaitGuestPayment" targetRef="Event_GuestPaymentTimeout" />
    <bpmn:sequenceFlow id="Flow_PaymentSuccess_To_CreateOrder" sourceRef="Event_GuestPaymentSuccess" targetRef="Task_CreateGuestOrder" />
    <bpmn:sequenceFlow id="Flow_PaymentTimeout_To_CancelReservation" sourceRef="Event_GuestPaymentTimeout" targetRef="Task_CancelGuestReservation" />
    <bpmn:sequenceFlow id="Flow_CancelReservation_To_EndExpired" sourceRef="Task_CancelGuestReservation" targetRef="End_GuestPaymentExpired" />
    <bpmn:sequenceFlow id="Flow_CreateOrder_To_SaveSnapshot" sourceRef="Task_CreateGuestOrder" targetRef="Task_SaveGuestSnapshotLookupToken" />
    <bpmn:sequenceFlow id="Flow_SaveSnapshot_To_PublishOrderCreated" sourceRef="Task_SaveGuestSnapshotLookupToken" targetRef="Task_PublishGuestOrderCreated" />
    <bpmn:sequenceFlow id="Flow_PublishOrderCreated_To_HandmadeGateway" sourceRef="Task_PublishGuestOrderCreated" targetRef="Gateway_ContainsHandmadeItems" />
    <bpmn:sequenceFlow id="Flow_NoHandmade_To_PackReadyMade" name="No" sourceRef="Gateway_ContainsHandmadeItems" targetRef="Task_StaffPackReadyMadeItems">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasHandmadeItems == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_HasHandmade_To_AssignStaff" name="Yes" sourceRef="Gateway_ContainsHandmadeItems" targetRef="Task_ManagerAssignStaffByItem">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${hasHandmadeItems == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PackReadyMade_To_SendReadyEmail" sourceRef="Task_StaffPackReadyMadeItems" targetRef="Task_SendGuestReadyToShipEmail" />
    <bpmn:sequenceFlow id="Flow_SendReadyEmail_To_EndReadyMade" sourceRef="Task_SendGuestReadyToShipEmail" targetRef="End_GuestOrderReadyMadeReady" />
    <bpmn:sequenceFlow id="Flow_AssignStaff_To_SubmitInitial" sourceRef="Task_ManagerAssignStaffByItem" targetRef="Task_StaffSubmitInitialCheckpoint" />
    <bpmn:sequenceFlow id="Flow_SubmitInitial_To_InitialReviewPolicy" sourceRef="Task_StaffSubmitInitialCheckpoint" targetRef="Gateway_InitialCheckpointReviewPolicy" />
    <bpmn:sequenceFlow id="Flow_InitialReviewNotRequired_To_SendInitialEmail" name="No" sourceRef="Gateway_InitialCheckpointReviewPolicy" targetRef="Task_SendGuestInitialCheckpointEmail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${checkpoint1RequiresManagerReview == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_InitialReviewRequired_To_ManagerReviewInitial" name="Yes" sourceRef="Gateway_InitialCheckpointReviewPolicy" targetRef="Task_ManagerReviewInitialCheckpoint">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${checkpoint1RequiresManagerReview == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ManagerReviewInitial_To_InitialApprovedGateway" sourceRef="Task_ManagerReviewInitialCheckpoint" targetRef="Gateway_InitialCheckpointApproved" />
    <bpmn:sequenceFlow id="Flow_InitialRejected_To_ReworkInitial" name="Rework" sourceRef="Gateway_InitialCheckpointApproved" targetRef="Task_StaffReworkInitialCheckpoint">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${checkpoint1Approved == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_InitialApproved_To_SendInitialEmail" name="Approve" sourceRef="Gateway_InitialCheckpointApproved" targetRef="Task_SendGuestInitialCheckpointEmail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${checkpoint1Approved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReworkInitial_To_SubmitInitial" sourceRef="Task_StaffReworkInitialCheckpoint" targetRef="Task_StaffSubmitInitialCheckpoint" />
    <bpmn:sequenceFlow id="Flow_SendInitialEmail_To_SubmitFinal" sourceRef="Task_SendGuestInitialCheckpointEmail" targetRef="Task_StaffSubmitFinalCheckpoint" />
    <bpmn:sequenceFlow id="Flow_SubmitFinal_To_ManagerFinalQC" sourceRef="Task_StaffSubmitFinalCheckpoint" targetRef="Task_ManagerFinalQC" />
    <bpmn:sequenceFlow id="Flow_ManagerFinalQC_To_FinalApprovedGateway" sourceRef="Task_ManagerFinalQC" targetRef="Gateway_FinalCheckpointApproved" />
    <bpmn:sequenceFlow id="Flow_FinalRejected_To_ReworkFinal" name="Rework" sourceRef="Gateway_FinalCheckpointApproved" targetRef="Task_StaffReworkFinalCheckpoint">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${finalApproved == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FinalApproved_To_SendFinalEmail" name="Approve" sourceRef="Gateway_FinalCheckpointApproved" targetRef="Task_SendGuestFinalCheckpointEmail">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${finalApproved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ReworkFinal_To_SubmitFinal" sourceRef="Task_StaffReworkFinalCheckpoint" targetRef="Task_StaffSubmitFinalCheckpoint" />
    <bpmn:sequenceFlow id="Flow_SendFinalEmail_To_MarkReady" sourceRef="Task_SendGuestFinalCheckpointEmail" targetRef="Task_MarkGuestOrderItemReady" />
    <bpmn:sequenceFlow id="Flow_MarkReady_To_EndHandmadeReady" sourceRef="Task_MarkGuestOrderItemReady" targetRef="End_GuestHandmadeOrderReady" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_GuestPurchaseFlow">
    <bpmndi:BPMNPlane id="BPMNPlane_GuestPurchaseFlow" bpmnElement="GuestPurchaseFlow">
      <bpmndi:BPMNShape id="Start_GuestCheckoutSubmitted_di" bpmnElement="Start_GuestCheckoutSubmitted">
        <dc:Bounds x="160" y="302" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="137" y="345" width="83" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ResolveGuestSession_di" bpmnElement="Task_ResolveGuestSession">
        <dc:Bounds x="260" y="280" width="120" height="80" />
