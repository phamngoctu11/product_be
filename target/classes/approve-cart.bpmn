<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_0al8ew2" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.43.1">
  <bpmn:process id="ApproveCartProcess" name="ApproveCartProcess" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="StartEvent_1" name="Nhan_don_hang">
      <bpmn:outgoing>Flow_1c54bu8</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_1exy6pl" name="Loai_thanh_toan">
      <bpmn:incoming>Flow_1c54bu8</bpmn:incoming>
      <bpmn:outgoing>Flow_07a1swb</bpmn:outgoing>
      <bpmn:outgoing>Flow_0gbs28z</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_1c54bu8" sourceRef="StartEvent_1" targetRef="Gateway_1exy6pl" />
    <bpmn:sequenceFlow id="Flow_07a1swb" name="COD" sourceRef="Gateway_1exy6pl" targetRef="Gateway_Join_Payment">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentMethod == 'COD'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:eventBasedGateway id="Gateway_019e67i">
      <bpmn:incoming>Flow_0gbs28z</bpmn:incoming>
      <bpmn:outgoing>Flow_1elkex4</bpmn:outgoing>
      <bpmn:outgoing>Flow_0vtbik3</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:sequenceFlow id="Flow_0gbs28z" name="ONLINE" sourceRef="Gateway_1exy6pl" targetRef="Gateway_019e67i">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentMethod == 'ONLINE'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:intermediateCatchEvent id="Event_09wdlq7" name="Chờ_Thanh_Toan_VNPay">
      <bpmn:incoming>Flow_1elkex4</bpmn:incoming>
      <bpmn:outgoing>Flow_0ksbeoc</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_0nt3o9e" messageRef="Message_30io1n5" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_1elkex4" sourceRef="Gateway_019e67i" targetRef="Event_09wdlq7" />
    <bpmn:sequenceFlow id="Flow_0ksbeoc" sourceRef="Event_09wdlq7" targetRef="Gateway_Join_Payment" />
    <bpmn:intermediateCatchEvent id="Event_0yyuvok" name="Timeout 15p">
      <bpmn:incoming>Flow_0vtbik3</bpmn:incoming>
      <bpmn:outgoing>Flow_0zwll0x</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_0jq9jnm">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT3M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_0vtbik3" sourceRef="Gateway_019e67i" targetRef="Event_0yyuvok" />
    <bpmn:sequenceFlow id="Flow_0zwll0x" sourceRef="Event_0yyuvok" targetRef="Activity_19exb78" />
    <bpmn:exclusiveGateway id="Gateway_Join_Payment">
      <bpmn:incoming>Flow_07a1swb</bpmn:incoming>
      <bpmn:incoming>Flow_0ksbeoc</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Manager_Approve</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_To_Manager_Approve" sourceRef="Gateway_Join_Payment" targetRef="manager_approve_order" />
    <bpmn:userTask id="manager_approve_order" name="Quản lý Duyệt đơn" camunda:candidateGroups="MANAGER">
      <bpmn:incoming>Flow_To_Manager_Approve</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_Approved</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Is_Approved" name="Duyệt?">
      <bpmn:incoming>Flow_Check_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_Not_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Check_Approved" sourceRef="manager_approve_order" targetRef="Gateway_Is_Approved" />
    <bpmn:sequenceFlow id="Flow_Not_Approved" name="Từ chối" sourceRef="Gateway_Is_Approved" targetRef="Activity_19exb78">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isApproved == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_19exb78" name="Huy_don_hang" camunda:delegateExpression="${cancelOrderDelegate}">
      <bpmn:incoming>Flow_0zwll0x</bpmn:incoming>
      <bpmn:incoming>Flow_Not_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_0r8wwzs</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="Event_1beu6gu" name="don_bi_huy">
      <bpmn:incoming>Flow_0r8wwzs</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0r8wwzs" sourceRef="Activity_19exb78" targetRef="Event_1beu6gu" />
    <bpmn:sequenceFlow id="Flow_Approved" name="Đã duyệt" sourceRef="Gateway_Is_Approved" targetRef="staff_export_warehouse">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${isApproved == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:userTask id="staff_export_warehouse" name="Nhân viên Xuất kho" camunda:candidateGroups="STAFF">
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:incoming>Flow_KCS_Failed</bpmn:incoming>
      <bpmn:outgoing>Flow_To_KCS</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_To_KCS" sourceRef="staff_export_warehouse" targetRef="manager_kcs_check" />
    <bpmn:userTask id="manager_kcs_check" name="Quản lý KCS Chốt xuất" camunda:candidateGroups="MANAGER">
      <bpmn:incoming>Flow_To_KCS</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_KCS</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_KCS" name="Khớp số lượng?">
      <bpmn:incoming>Flow_Check_KCS</bpmn:incoming>
      <bpmn:outgoing>Flow_KCS_Failed</bpmn:outgoing>
      <bpmn:outgoing>Flow_KCS_Passed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Check_KCS" sourceRef="manager_kcs_check" targetRef="Gateway_KCS" />
    <bpmn:sequenceFlow id="Flow_KCS_Failed" name="Lệch, báo lại" sourceRef="Gateway_KCS" targetRef="staff_export_warehouse">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${kcsPassed == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_KCS_Passed" name="OK" sourceRef="Gateway_KCS" targetRef="Activity_0rfojij">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${kcsPassed == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:serviceTask id="Activity_0rfojij" name="Trừ Tồn Kho &#38; Ghi Sao Kê" camunda:delegateExpression="${deductInventoryDelegate}">
      <bpmn:incoming>Flow_KCS_Passed</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Customer</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_To_Customer" sourceRef="Activity_0rfojij" targetRef="customer_confirm_receipt" />
    <bpmn:userTask id="customer_confirm_receipt" name="Khách Xác Nhận Nhận Hàng" camunda:candidateGroups="USER">
      <bpmn:incoming>Flow_To_Customer</bpmn:incoming>
      <bpmn:outgoing>Flow_To_Reconciliation</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_To_Reconciliation" sourceRef="customer_confirm_receipt" targetRef="reconciliation_delegate" />
    <bpmn:serviceTask id="reconciliation_delegate" name="Hệ thống Kiểm tra Thất thoát" camunda:delegateExpression="${reconciliationDelegate}">
      <bpmn:incoming>Flow_To_Reconciliation</bpmn:incoming>
      <bpmn:outgoing>Flow_To_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_To_End" sourceRef="reconciliation_delegate" targetRef="Event_1s3q4kl" />
    <bpmn:endEvent id="Event_1s3q4kl" name="hoan_thanh_don_hang">
      <bpmn:incoming>Flow_To_End</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:message id="Message_30io1n5" name="Msg_PaymentSuccess" />
